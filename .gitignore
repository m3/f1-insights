*.db-wal

# Build Outputs
portal/dist
public/data/*.json
!public/data/.gitkeep

# System
.DS_Store

# TracingInsights cloned data repo
data/tracing-insights/
testvenv/

# mex AST index — generated, rebuilt by `mex graph index`.
# The -wal/-shm sidecars are live SQLite journal state and change on every
# read, so tracking them produces permanent spurious diffs.
.mex/graph.db
.mex/graph.db-shm
.mex/graph.db-wal
